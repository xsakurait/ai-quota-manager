# Copy to .env for local development. Placeholder values only — no secrets.
NEXT_PUBLIC_APP_NAME=無料枠管理アプリ
QUOTA_STORAGE_KEY=ai-quota-usage-v1
READINGS_FILE=./data/readings.json
# Only for the local reader script scripts/readers/modal_billing.py.
# Real tokens must never be committed to git — set them in your shell instead.
